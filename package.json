{
  "name": "smart-asset-studio",
  "version": "1.0.0",
  "private": true,
  "main": "main/index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron-dev": "electron .",
    "dist": "next build && electron-builder"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@imgly/background-removal-data": "^1.4.5",
    "@tensorflow/tfjs": "^4.11.0",
    "electron-serve": "^1.3.0",
    "fabric": "^7.1.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.26.2",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.8",
    "upscaler": "^1.0.0-beta.19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.2",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.smartasset.studio",
    "productName": "Smart Asset Studio",
    "compression": "normal",
    "files": [
      "out/**/*",
      "main/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
